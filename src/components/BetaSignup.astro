<section class='px-6'>
	<div
		class='max-w-lg mx-auto bg-transparent md:bg-card border-0 md:border-4 border-border rounded-[2.5rem] p-4 md:p-12 shadow-none md:shadow-2xl relative overflow-hidden'
	>
		<div
			class='hidden md:block absolute top-0 right-0 -mt-4 -mr-4 w-24 h-24 bg-primary/10 rounded-full blur-2xl'
		>
		</div>

		<div
			id='tab-container'
			class='flex bg-background/50 p-1 rounded-2xl mb-8 border-2 border-border relative z-10 mt-2 md:mt-0'
		>
			<button
				id='tab-android'
				class='flex-1 py-2 rounded-xl font-bold text-sm transition-all text-muted-foreground cursor-pointer'
				>Android</button
			>
			<button
				id='tab-ios'
				class='flex-1 py-2 rounded-xl font-bold text-sm transition-all text-muted-foreground cursor-pointer'
				>iOS (Apple)</button
			>
		</div>

		<div class='grid grid-cols-1 items-start'>
			<div
				id='content-android'
				class='col-start-1 row-start-1 transition-all duration-300 opacity-0 invisible pointer-events-none'
			>
				<div class='text-center mb-8'>
					<h2
						class='text-3xl font-black mb-3 text-foreground uppercase tracking-tighter'
					>
						Android Beta
					</h2>
					<p class='text-muted-foreground text-sm'>
						Join the waiting list for the Google Play Store closed
						track.
					</p>
				</div>

				<form id='beta-tester-form' class='space-y-6'>
					<div class='relative'>
						<input
							type='email'
							id='beta-email'
							name='entry.1612656547'
							required
							placeholder='Google Play Email'
							class='placeholder:text-muted-foreground text-muted-foreground w-full px-6 py-4 bg-background border-2 border-border rounded-2xl focus:ring-4 focus:ring-primary/20 outline-none transition-all'
						/>
						<p
							class='mt-3 px-1 text-[11px] leading-relaxed text-muted-foreground italic'
						>
							<span class='text-primary font-bold'
								>Important:</span
							> Use your <span class='text-foreground font-bold'
								>Play Store email</span
							> to receive the invite.
						</p>
					</div>
					<button
						type='submit'
						id='submit-button'
						class='cursor-pointer w-full bg-primary text-foreground font-bold py-4 rounded-2xl hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg flex items-center justify-center gap-2'
					>
						Request Access
					</button>
				</form>
			</div>

			<div
				id='content-ios'
				class='col-start-1 row-start-1 transition-all duration-300 opacity-0 invisible pointer-events-none'
			>
				<div class='text-center mb-8'>
					<h2
						class='text-3xl font-black mb-3 text-foreground uppercase tracking-tighter'
					>
						iOS Beta
					</h2>
					<p class='text-muted-foreground text-sm'>
						Join via TestFlight. No waiting list required for Apple
						users.
					</p>
				</div>

				<div class='space-y-6'>
					<div
						class='bg-background/50 border-2 border-border rounded-2xl p-6 text-sm space-y-4'
					>
						<div class='flex gap-4 items-start'>
							<span
								class='bg-primary text-foreground w-6 h-6 rounded-full flex-none flex items-center justify-center font-bold text-[10px]'
								>1</span
							>
							<p class='text-muted-foreground'>
								Install <strong>TestFlight</strong> from the App
								Store.
							</p>
						</div>
						<div class='flex gap-4 items-start'>
							<span
								class='bg-primary text-foreground w-6 h-6 rounded-full flex-none flex items-center justify-center font-bold text-[10px]'
								>2</span
							>
							<p class='text-muted-foreground'>
								Tap the button below to join the <strong
									>RTSP Camera</strong
								> beta track.
							</p>
						</div>
					</div>

					<a
						href='https://testflight.apple.com/join/W9xB5YZQ'
						target='_blank'
						class='w-full bg-[#007AFF] text-white font-bold py-4 rounded-2xl hover:scale-[1.02] active:scale-[0.98] transition-all shadow-lg flex items-center justify-center gap-2'
					>
						<span>Open TestFlight</span>
						<svg
							width='20'
							height='20'
							viewBox='0 0 24 24'
							fill='none'
							stroke='currentColor'
							stroke-width='2.5'
						>
							<path
								d='M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6'
							></path>
							<polyline points='15 3 21 3 21 9'></polyline>
							<line x1='10' y1='14' x2='21' y2='3'></line>
						</svg>
					</a>
				</div>
			</div>

			<div
				id='success-state'
				class='col-start-1 row-start-1 transition-all duration-300 opacity-0 invisible pointer-events-none text-center py-10'
			>
				<div
					class='w-20 h-20 bg-primary/10 rounded-full flex items-center justify-center mx-auto mb-6'
				>
					<span class='text-4xl'>🎥</span>
				</div>
				<h3 class='text-foreground text-2xl font-black mb-2'>
					You're on the list!
				</h3>
				<p class='text-muted-foreground mb-6'>
					We'll send an invite as soon as a spot opens up.
				</p>
				<button
					onclick='window.location.reload()'
					class='text-xs underline text-foreground opacity-50 hover:opacity-100 transition-opacity cursor-pointer'
					>Back to form</button
				>
			</div>
		</div>

		<p
			class='text-[10px] text-center text-foreground mt-8 uppercase tracking-[0.2em] opacity-40 font-bold relative z-10'
		>
			Limited slots available
		</p>
	</div>
</section>

<script>
	const initBetaSection = () => {
		const btnAndroid = document.getElementById('tab-android');
		const btnIos = document.getElementById('tab-ios');
		const contentAndroid = document.getElementById('content-android');
		const contentIos = document.getElementById('content-ios');
		const tabContainer = document.getElementById('tab-container');
		const successState = document.getElementById('success-state');
		const form = document.getElementById('beta-tester-form');
		const emailInput = document.getElementById('beta-email');
		const submitBtn = document.getElementById('submit-button');

		const switchTab = (active) => {
			if (active === 'android') {
				btnAndroid?.classList.add('bg-primary', 'text-foreground', 'pointer-events-none');
				btnAndroid?.classList.remove('text-muted-foreground', 'cursor-pointer');
				btnIos?.classList.remove('bg-primary', 'text-foreground', 'pointer-events-none');
				btnIos?.classList.add('text-muted-foreground', 'cursor-pointer');

				contentAndroid?.classList.add('opacity-100', 'visible');
				contentAndroid?.classList.remove('opacity-0', 'invisible', 'pointer-events-none', 'hidden');
				contentIos?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
				contentIos?.classList.remove('opacity-100', 'visible');
			} else {
				btnIos?.classList.add('bg-primary', 'text-foreground', 'pointer-events-none');
				btnIos?.classList.remove('text-muted-foreground', 'cursor-pointer');
				btnAndroid?.classList.remove('bg-primary', 'text-foreground', 'pointer-events-none');
				btnAndroid?.classList.add('text-muted-foreground', 'cursor-pointer');

				contentIos?.classList.add('opacity-100', 'visible');
				contentIos?.classList.remove('opacity-0', 'invisible', 'pointer-events-none', 'hidden');
				contentAndroid?.classList.add('opacity-0', 'invisible', 'pointer-events-none');
				contentAndroid?.classList.remove('opacity-100', 'visible');
			}
		};

		const userAgent = navigator.userAgent || navigator.vendor || window.opera;
		const isIOS = /iPad|iPhone|iPod/.test(userAgent) && !window.MSStream;

		if (isIOS) switchTab('ios');
		else switchTab('android');

		btnAndroid?.addEventListener('click', () => switchTab('android'));
		btnIos?.addEventListener('click', () => switchTab('ios'));

		form?.addEventListener('submit', async (e) => {
			e.preventDefault();
			const email = emailInput?.value;
			if (!email) return;

			if (submitBtn) {
				submitBtn.innerHTML = `<span>Joining...</span>`;
				submitBtn.classList.add('opacity-50', 'pointer-events-none');
			}

			try {
				const fbzx = Math.floor(
					Math.random() * 2 ** 63 - 2 ** 62,
				).toString();

				const body = new URLSearchParams();
				body.append('entry.1612656547', email);
				body.append('fvv', '1');
				body.append('partialResponse', `[null,null,"${fbzx}"]`);
				body.append('pageHistory', '0');
				body.append('fbzx', fbzx);
				body.append('submissionTimestamp', Date.now().toString());

				await fetch(
					'https://docs.google.com/forms/d/e/1FAIpQLScHCjylYYJDIIJqhX9I2p0Z6kErxLdxOcVLlAC-iy5y-UVhEA/formResponse',
					{
						method: 'POST',
						mode: 'no-cors',
						headers: {
							'Content-Type': 'application/x-www-form-urlencoded',
						},
						body: body.toString(),
					},
				);

				tabContainer?.classList.add('hidden');
				contentAndroid?.classList.add('hidden');
				contentIos?.classList.add('hidden');

				successState?.classList.remove(
					'opacity-0',
					'invisible',
					'pointer-events-none',
				);
				successState?.classList.add('opacity-100', 'visible');
			} catch (error) {
				console.error(error);
				if (submitBtn) {
					submitBtn.innerHTML = `Request Access`;
					submitBtn.classList.remove(
						'opacity-50',
						'pointer-events-none',
					);
				}
			}
		});
	};

	initBetaSection();
	document.addEventListener('astro:after-swap', initBetaSection);
</script>
