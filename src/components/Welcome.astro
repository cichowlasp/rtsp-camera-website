---
import ImageGallery from './ImageGallery.astro';
import StoreBadges from './StoreBadges.astro';
import Screen1 from '../assets/Screenshot1.png';
import Screen2 from '../assets/Screenshot2.png';
import Screen3 from '../assets/Screenshot3.png';
import Screen4 from '../assets/Screenshot4.png';
import Screen5 from '../assets/Screenshot5.png';
import Screen6 from '../assets/Screenshot6.png';

const features = [
	{
		num: '01',
		title: 'H.264 + AAC',
		text: 'Broadcast-grade video and audio over RTSP, ready for any client.',
	},
	{
		num: '02',
		title: 'On-device server',
		text: 'The phone streams directly — no middleman, no cloud account.',
	},
	{
		num: '03',
		title: 'Home Assistant ready',
		text: 'Add it as a Generic Camera in seconds. Also works with VLC and Frigate.',
	},
	{
		num: '04',
		title: '100% local',
		text: 'No analytics, no tracking, no cloud storage. Your footage stays yours.',
	},
];

const screenshots = [
	{ src: Screen1, alt: 'RTSP Camera screenshot 1' },
	{ src: Screen2, alt: 'RTSP Camera screenshot 2' },
	{ src: Screen3, alt: 'RTSP Camera screenshot 3' },
	{ src: Screen4, alt: 'RTSP Camera screenshot 4' },
	{ src: Screen5, alt: 'RTSP Camera screenshot 5' },
	{ src: Screen6, alt: 'RTSP Camera screenshot 6' },
];
---

<header class='pt-16 pb-8 px-6 text-center'>
	<div class='relative mx-auto w-24 h-24 mb-6'>
		<img
			src='/app-icon.png'
			class='w-24 h-24 rounded-3xl dark:hidden'
			alt='RTSP Camera'
		/>
		<img
			src='/app-icon-dark.png'
			class='w-24 h-24 rounded-3xl hidden dark:block'
			alt='RTSP Camera'
		/>
	</div>
	<h1
		class='text-4xl text-foreground font-black tracking-tighter uppercase mb-2'
	>
		RTSP Camera
	</h1>
	<p class='text-muted-foreground font-medium italic'>
		Turn any phone into a private IP camera.
	</p>
</header>
<main>
	<StoreBadges />
	<section class='max-w-3xl mx-auto px-6 mb-24 text-center'>
		<h2
			class='text-3xl font-black tracking-tighter uppercase mb-6 text-foreground'
		>
			A real IP camera in your pocket
		</h2>
		<p class='text-lg text-muted-foreground leading-relaxed mb-12'>
			RTSP Camera turns your spare phone into a full IP camera — streaming
			H.264 video and AAC audio over RTSP, straight from the phone itself.
			No cloud, no relay, no subscription. Your video never leaves your
			local network.
		</p>

		<div class='grid grid-cols-1 md:grid-cols-2 gap-10 text-left'>
			{
				features.map((f) => (
					<div class='space-y-2'>
						<h3
							class='font-black uppercase tracking-widest text-sm text-primary'
						>
							{f.num}. {f.title}
						</h3>
						<p class='text-muted-foreground'>{f.text}</p>
					</div>
				))
			}
		</div>
	</section>
	<section class='max-w-6xl mx-auto px-6 pb-24'>
		<h2
			class='text-xs font-bold tracking-[0.3em] uppercase text-center text-muted-foreground mb-10'
		>
			App Gallery
		</h2>

		<ImageGallery screenshots={screenshots} />
	</section>
	<section class='pb-12 px-6'>
		<div class='flex flex-col items-center justify-center text-center'>
			<p class='text-sm text-muted-foreground mb-4'>
				Have questions or feedback?
			</p>
			<a
				href='mailto:cichowlas.p@gmail.com'
				class='group relative flex items-center gap-2.5 px-4 py-3 rounded-full bg-secondary/30 hover:bg-secondary/50 border border-border/60 transition-all hover:scale-[1.02] active:scale-95'
			>
				<span class='flex h-2 w-2'>
					<span
						class='animate-ping absolute inline-flex h-2 w-2 rounded-full bg-primary opacity-75'
					></span>
					<span
						class='relative inline-flex rounded-full h-2 w-2 bg-primary'
					></span>
				</span>
				<p
					class='text-sm font-medium text-foreground whitespace-nowrap'
				>
					<span class='font-bold'>Contact support</span>
				</p>
				<svg
					xmlns='http://www.w3.org/2000/svg'
					width='14'
					height='14'
					viewBox='0 0 24 24'
					fill='none'
					stroke='currentColor'
					stroke-width='3'
					stroke-linecap='round'
					stroke-linejoin='round'
					class='text-muted-foreground group-hover:translate-x-1 transition-transform'
				>
					<path d='M5 12h14m-7-7 7 7-7 7'></path>
				</svg>
			</a>
		</div>
	</section>
</main>
